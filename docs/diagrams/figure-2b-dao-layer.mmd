        ~insert(Connection, String, String, Object[])$ int
        ~search(Connection, String, String, List~Object~, int, int, int, String, RowMapper)$ Page~T~
    }

    class RowMapper~T~ {
        <<interface>>
        +map(ResultSet) T
    }

    class DataAccessException {
        -String sqlState
        +getSqlState() String
